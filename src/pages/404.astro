---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="404 — Page not found · Triv" description="That page doesn’t exist. Head back to the Triv home page." noindex>
  <SiteHeader />

  <main class="notfound shell" id="main-content">
    <p class="eyebrow"><span></span> Error 404 · Route not found</p>
    <h1>Off the <em>known route.</em></h1>
    <p class="notfound-intro">This page doesn’t exist — or it moved while you weren’t looking. Everything worth seeing is back on the home page.</p>
    <div class="notfound-actions">
      <a class="button button-primary" href="/">Return home <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/#work">See selected work <span aria-hidden="true">↓</span></a>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
