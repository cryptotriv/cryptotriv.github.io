---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { gallery } from '../../data/gallery';
---

<BaseLayout title="Gallery — Triv" description="Artwork and avatars of Triv, the crypto-native MEV searcher.">
  <SiteHeader current="gallery" />

  <main id="main-content">
    <section class="gallery shell" aria-labelledby="gallery-title">
      <p class="eyebrow"><span></span> Gallery · {gallery.length} pieces</p>
      <h1 id="gallery-title">Art &amp; <em>avatars.</em></h1>
      <p class="gallery-intro">Illustrations of Triv across styles and moods. Select any piece to open it at full size.</p>
      <GalleryGrid pieces={gallery} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
