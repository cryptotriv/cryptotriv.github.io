---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const alts = [
  'Triv with glowing headphones on a magenta background',
  'Triv in a purple scarf and white hoodie',
  'Triv smiling in a grey hoodie on a magenta background',
  'Sketch-style close-up of Triv with glowing headphones',
  'Moody painted portrait of Triv in a blue jacket',
  'Chibi Triv with a laptop in a round badge',
  'Triv in a black lace dress adjusting her headphones',
  'Triv in an open jacket against a summer sky',
  'Triv in a purple scarf and white hoodie, alternate version',
  'Wide illustration of several Triv characters around a desk setup',
];

const modules = import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.{jpg,png}', { eager: true });
const sources = Object.keys(modules).sort().map((path) => modules[path].default);

if (sources.length !== alts.length) {
  throw new Error(`Gallery has ${sources.length} images but ${alts.length} alt texts`);
}

const pieces = await Promise.all(
  sources.map(async (src, index) => ({
    src,
    alt: alts[index],
    number: String(index + 1).padStart(2, '0'),
    wide: src.width / src.height > 1.4,
    full: await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' }),
  })),
);
---

<BaseLayout title="Gallery — Triv" description="Artwork and avatars of Triv, the crypto-native MEV searcher.">
  <SiteHeader current="gallery" />

  <main id="main-content">
    <section class="gallery shell" aria-labelledby="gallery-title">
      <p class="eyebrow"><span></span> Gallery · {pieces.length} pieces</p>
      <h1 id="gallery-title">Art &amp; <em>avatars.</em></h1>
      <p class="gallery-intro">Illustrations of Triv across styles and moods. Select any piece to open it at full size.</p>
      <ol class="gallery-grid">
        {pieces.map((piece) => (
          <li class:list={['gallery-item', { 'gallery-wide': piece.wide }]}>
            <a href={piece.full.src} target="_blank" rel="noopener noreferrer" aria-label={`Open piece ${piece.number} at full size: ${piece.alt}`}>
              <Image src={piece.src} alt={piece.alt} widths={piece.wide ? [760, 1180, 1800] : [400, 600, 900]} sizes={piece.wide ? '(max-width: 760px) calc(100vw - 32px), 1180px' : '(max-width: 760px) calc(50vw - 22px), (max-width: 1228px) calc(33vw - 24px), 380px'} loading="lazy" />
              <span class="gallery-number" aria-hidden="true">{piece.number}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
