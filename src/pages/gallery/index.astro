---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { gallery } from '../../data/gallery';

const rowHeight = 320;

const pieces = await Promise.all(
  gallery.map(async (piece) => {
    const number = String(piece.number).padStart(2, '0');
    if (piece.kind === 'video') {
      const ratio = piece.poster.width / piece.poster.height;
      const poster = await getImage({ src: piece.poster, width: 600, format: 'webp' });
      return { ...piece, number, ratio, href: piece.src, poster: poster.src };
    }
    const ratio = piece.src.width / piece.src.height;
    const full = await getImage({ src: piece.src, width: Math.min(piece.src.width, 2400), format: 'webp' });
    return { ...piece, number, ratio, href: full.src };
  }),
);
---

<BaseLayout title="Gallery — Triv" description="Artwork and avatars of Triv, the crypto-native MEV searcher.">
  <SiteHeader current="gallery" />

  <main id="main-content">
    <section class="gallery shell" aria-labelledby="gallery-title">
      <p class="eyebrow"><span></span> Gallery · {pieces.length} pieces</p>
      <h1 id="gallery-title">Art &amp; <em>avatars.</em></h1>
      <p class="gallery-intro">Illustrations of Triv across styles and moods. Select any piece to open it at full size.</p>
      <ol class="gallery-grid" data-gallery-grid>
        {pieces.map((piece) => (
          <li class="gallery-item" style={`--ratio:${piece.ratio.toFixed(4)}`} data-ratio={piece.ratio.toFixed(4)}>
            <a href={piece.href} target="_blank" rel="noopener noreferrer" aria-label={`Open piece ${piece.number} at full size: ${piece.alt}`}>
              {piece.kind === 'video' ? (
                <video src={piece.src} poster={piece.poster} muted loop playsinline preload="none" aria-hidden="true" data-gallery-video></video>
              ) : (
                <Image src={piece.src} alt="" widths={[1, 2].map((scale) => Math.min(piece.src.width, Math.round(piece.ratio * rowHeight * 1.4 * scale)))} sizes={`(max-width: 760px) min(${Math.round(piece.ratio * 140 * 2)}px, calc(100vw - 32px)), ${Math.round(piece.ratio * rowHeight * 1.4)}px`} loading="lazy" />
              )}
              <span class="gallery-number" aria-hidden="true">{piece.number}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  import { justifyGallery } from '../../scripts/justified-gallery';

  document.querySelectorAll<HTMLElement>('[data-gallery-grid]').forEach(justifyGallery);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-gallery-video]');
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          void video.play();
        } else {
          video.pause();
        }
      }
    });
    videos.forEach((video) => observer.observe(video));
  }
</script>
