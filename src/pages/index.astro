---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import mevDashboard from '../assets/work/mev-dashboard.png';
import youtubeThumb from '../assets/work/youtube.jpg';

const tickerItems = ['MEV SEARCHING', 'SMART CONTRACT SECURITY', 'DEFI INFRASTRUCTURE', 'AI-NATIVE WORKFLOWS'];
const tickerRepeats = 3;
const skills = ['Rust', 'Go', 'Solidity', 'Node.js'];
const year = new Date().getFullYear();
---

<BaseLayout>
  <header class="site-header shell">
    <a class="wordmark" href="#top" aria-label="Triv home">TRIV<span>_</span></a>
    <nav aria-label="Primary navigation">
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="header-availability" href="#contact"><i></i> Available</a>
  </header>

  <main id="main-content">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Solo MEV searcher · 2022—now</p>
        <h1 id="hero-title">Crypto from <em>top to bottom.</em></h1>
        <p class="hero-intro">I’m Triv — a crypto-native builder with 4+ years of hands-on experience across the crypto, MEV, and DeFi stack.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact">Start a conversation <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#work">See selected work <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="portrait-frame">
          <img src="/images/triv-profile.png" alt="Portrait of Triv" width="500" height="451" loading="eager" decoding="async" fetchpriority="high" />
        </div>
        <div class="signal-card">
          <span class="signal-label">CURRENT SIGNAL</span>
          <strong>Seeking the next<br />hard problem.</strong>
          <span class="signal-pulse"><i></i> ONLINE</span>
        </div>
        <div class="coordinate coordinate-top">01° 42' 24.0&quot; N</div>
        <div class="coordinate coordinate-bottom">PROTOCOL / HUMAN</div>
      </div>
    </section>

    <div class="ticker" aria-hidden="true"><div>{[0, 1].map(() => <div>{Array.from({ length: tickerRepeats }, () => tickerItems.map((item) => <><span>{item}</span><b>✦</b></>))}</div>)}</div></div>

    <section class="about shell section" id="about" aria-labelledby="about-title">
      <div class="section-marker"><span>01</span><i></i></div>
      <div class="section-heading"><p class="eyebrow">Background</p><h2 id="about-title">Everything from software and infrastructure, to content and writing.</h2></div>
      <div class="about-copy">
        <p>Before crypto, I was an electronics engineer and engineering manager. Today, I’m a solo MEV searcher and have been using AI and coding agents ever since they were introduced. I’ve previously done content creation as well, showing my English fluency and communication skills.</p>
        <div class="link-row"><a class="text-link" href="https://github.com/cryptotriv" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a class="text-link" href="https://www.youtube.com/@TrivChannel" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="work section" id="work" aria-labelledby="work-title">
      <div class="shell">
        <div class="work-heading">
          <div class="section-marker"><span>02</span><i></i></div>
          <h2 class="eyebrow" id="work-title">Selected work</h2>
        </div>
        <div class="project-grid">
          <article class="project-card project-dashboard">
            <div class="project-visual project-shot"><Image class="shot-dashboard" src={mevDashboard} alt="MEV Dashboard screenshot: a dark operations view with summary stat tiles for MEV activity" widths={[640, 960, 1280]} sizes="(max-width: 760px) max(calc(100vw - 69px), 556px), 629px" /></div>
            <div class="project-meta"><span>01 / PRIVATE SYSTEM</span><span>MEV OPERATIONS</span></div>
            <h3>MEV Dashboard</h3>
            <p>An operations surface for observing the moving pieces behind MEV research and execution.</p>
            <ul class="tag-list" aria-label="Project areas"><li>Data</li><li>Execution</li><li>Monitoring</li></ul>
          </article>

          <article class="project-card project-arbitrage">
            <div class="project-visual code-visual" aria-hidden="true">
              <div class="code-window-bar"><span></span><span></span><span></span><b>searcher.go</b></div>
              <pre><code><mark>func</mark> <strong>FindOpportunity</strong>(pool <em>Pool</em>) &#123;<br />  route := <strong>simulate</strong>(pool)<br />  <mark>if</mark> route.<em>Profitable</em>() &#123;<br />    <strong>submit</strong>(route)<br />  &#125;<br />&#125;</code></pre>
              <div class="code-status"><span><i></i> educational reference</span><b>METIS</b></div>
            </div>
            <div class="project-meta"><span>02 / OPEN SOURCE</span><span>GO · FLASHBOTS</span></div>
            <h3>Metis Simple Arbitrage Bot</h3>
            <p>A Go adaptation of Flashbots’ simple-arbitrage example, improved for Metis. A historical deep dive and educational reference — not software intended to run today.</p>
            <div class="link-row"><a class="text-link" href="https://github.com/cryptotriv/metis-simple-arbitrage-bot" target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">↗</span></a><a class="text-link subtle" href="https://www.youtube.com/live/rexycfGCPeI" target="_blank" rel="noopener noreferrer">Watch deep dive <span aria-hidden="true">↗</span></a></div>
          </article>

          <article class="project-card project-youtube">
            <div class="project-visual project-shot"><Image src={youtubeThumb} alt="YouTube thumbnail for the video Why Polymarket Isn’t An Assassination Market (Realistically)" widths={[560, 840, 1120]} sizes="(max-width: 760px) max(calc(100vw - 69px), 480px), 546px" /></div>
            <div class="project-meta"><span>03 / CONTENT</span><span>YOUTUBE · @TRIVCHANNEL</span></div>
            <h3>YouTube</h3>
            <p>Long-form videos on crypto and MEV — from a code walkthrough of my first arbitrage bot to prediction-market analysis.</p>
            <div class="link-row"><a class="text-link" href="https://www.youtube.com/@TrivChannel" target="_blank" rel="noopener noreferrer">Visit channel <span aria-hidden="true">↗</span></a></div>
          </article>

          <article class="project-card project-messages">
            <div class="project-visual chat-visual" aria-hidden="true">
              <div class="chat-header"><span class="chat-avatar">M</span><div><strong>Messages On Ethereum</strong><small>ETHEREUM · INPUT DATA</small></div></div>
              <div class="chat-feed">
                <div class="chat-bubble"><span>gm</span><small>decoded from calldata</small></div>
                <div class="chat-bubble"><span>congrats on the merge</span><small>decoded from calldata</small></div>
                <div class="chat-bubble"><span>please return the funds and keep 10%</span><small>decoded from calldata</small></div>
              </div>
            </div>
            <div class="project-meta"><span>04 / TELEGRAM</span><span>ETHEREUM · MESSAGES</span></div>
            <h3>Messages On Ethereum</h3>
            <p>A Telegram feed that surfaces human-readable messages people embed in Ethereum transactions.</p>
            <div class="link-row"><a class="text-link" href="https://t.me/TrivMessagesOnEthereum" target="_blank" rel="noopener noreferrer">Open on Telegram <span aria-hidden="true">↗</span></a></div>
          </article>
        </div>
      </div>
    </section>

    <section class="skills shell section" aria-labelledby="skills-title">
      <div class="section-marker"><span>03</span><i></i></div>
      <div class="skills-intro"><p class="eyebrow">Toolbox</p><h2 id="skills-title">Languages for the sharp end.</h2></div>
      <ul class="skills-list">{skills.map((skill, index) => <li><span>0{index + 1}</span><strong>{skill}</strong><i aria-hidden="true"></i></li>)}</ul>
    </section>

    <section class="contact shell" id="contact" aria-labelledby="contact-title">
      <div class="contact-grid"></div>
      <p class="eyebrow"><span></span> Open to new opportunities</p>
      <h2 id="contact-title">Let’s build an <em>unfair advantage.</em></h2>
      <p>I’m looking for work where deep technical thinking, ownership, and practical execution make a difference.</p>
      <a class="email-link" href="mailto:cryptotriv@gmail.com">cryptotriv@gmail.com <span aria-hidden="true">↗</span></a>
      <div class="contact-socials"><a href="https://github.com/cryptotriv" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="https://x.com/cryptotriv" target="_blank" rel="noopener noreferrer">X / @cryptotriv <span aria-hidden="true">↗</span></a><a href="https://t.me/cryptotriv" target="_blank" rel="noopener noreferrer">Telegram / @cryptotriv <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>

  <footer class="site-footer shell"><a class="wordmark" href="#top">TRIV<span>_</span></a><p>© {year} Triv. Built at the intersection.</p><a href="#top">Back to top ↑</a></footer>
</BaseLayout>
